# Runs the Hyprland keybind HUD. Install: systemctl --user link $PWD/systemd/hivectl.service
# then: systemctl --user enable --now hivectl.service
[Unit]
Description=Kreo Hive 98 Hyprland keybind HUD
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/hivectl hud
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
